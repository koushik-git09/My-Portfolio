# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=portfolio_db

# Email Notification Settings
# Your email where notifications will be sent
NOTIFICATION_EMAIL=koushikgoud912@gmail.com

# OPTION 1: Free Gmail SMTP (recommended)
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Search "App Passwords" -> Create one called "Portfolio"
# 3. Paste your 16-character app password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# OPTION 2: Resend API (alternative)
# Create a free API key at https://resend.com
RESEND_API_KEY=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
